<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hotel Management</title>
<style>
:root{--ink:#243242;--nav:#17324d;--accent:#167d87;--line:#dce4ea;--muted:#637180;--surface:#fff;--bg:#f4f7f8}
*{box-sizing:border-box}
body{font-family:"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;margin:0;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}
nav{background:var(--nav);padding:10px 24px;display:flex;gap:16px;align-items:center;flex-wrap:wrap;position:sticky;top:0;z-index:10;box-shadow:0 2px 12px #10263a33}
nav a{color:#ecf0f1;text-decoration:none;font-size:14px}
nav a:hover{color:#f1c40f}
.container{max-width:1220px;margin:24px auto;padding:0 18px}
.card{background:#fff;border-radius:8px;padding:20px;margin-bottom:16px;box-shadow:0 1px 3px rgba(0,0,0,.08)}
table{width:100%;border-collapse:collapse;font-size:14px;background:#fff}
th,td{padding:8px 10px;border-bottom:1px solid #eee;text-align:left}
th{background:#f8f9fa}
.btn{display:inline-block;background:var(--accent);color:#fff;border:none;padding:8px 14px;border-radius:5px;cursor:pointer;text-decoration:none;font-size:14px}
.btn:hover{filter:brightness(1.08)}
.btn-danger{background:#c0392b}.btn-success{background:#27ae60}
.btn-muted{background:#687887}.btn-small{padding:5px 9px;font-size:12px}
input,select,textarea,button{font:inherit}
input,select,textarea{padding:7px;border:1px solid #ccc;border-radius:5px;font-size:14px;margin:2px 0}
input:focus,select:focus,textarea:focus,button:focus,a:focus{outline:3px solid #61c6cf;outline-offset:2px}
label{font-size:13px;color:#636e72;display:block;margin-top:8px}
.err{background:#fdecea;color:#c0392b;padding:10px;border-radius:5px;margin-bottom:12px}
.msg{background:#eafaf1;color:#1e8449;padding:10px;border-radius:5px;margin-bottom:12px}
.badge{padding:2px 8px;border-radius:10px;font-size:12px;background:#dfe6e9}
h2{margin-top:0}
.page-head{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:16px}.page-head h1{margin:0;font-size:28px}
.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px}.col-4{grid-column:span 4}.col-6{grid-column:span 6}.col-8{grid-column:span 8}.col-12{grid-column:span 12}
.kpi{border-top:4px solid var(--accent);min-height:128px}.kpi .value{font-size:30px;font-weight:700;margin:8px 0}.kpi .label{color:var(--muted);font-size:13px;text-transform:uppercase;letter-spacing:.04em}
.nav-card{color:var(--ink);text-decoration:none;border:1px solid var(--line);transition:.15s}.nav-card:hover{transform:translateY(-2px);box-shadow:0 6px 18px #17324d1a}.nav-card h3{margin:0 0 8px}.muted{color:var(--muted)}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 16px}.form-grid .full{grid-column:1/-1}.form-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:14px}.inline{display:inline-flex;gap:6px;align-items:center;flex-wrap:wrap}.inline label{margin:0}.table-wrap{overflow-x:auto}.pagination{display:flex;justify-content:center;align-items:center;gap:12px;margin-top:16px}.empty{padding:24px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:8px}.image-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px}.image-tile{border:1px solid var(--line);border-radius:8px;padding:8px}.image-tile img{width:100%;height:120px;object-fit:cover;border-radius:5px;background:#edf1f3}.danger-text{color:#a93226}.status-READY,.status-COMPLETED,.status-CLOSED{background:#d5f5e3}.status-BLOCKED,.status-OUT_OF_SERVICE,.status-FAIL{background:#fadbd8}.status-IN_PROGRESS,.status-ASSIGNED{background:#d6eaf8}
@media(max-width:800px){nav{position:static;padding:10px 14px;gap:12px}.container{margin:16px auto}.col-4,.col-6,.col-8{grid-column:span 12}.form-grid{grid-template-columns:1fr}.page-head h1{font-size:23px}th,td{white-space:nowrap}}
</style>
</head>
<body>
<nav>
  <a href="${pageContext.request.contextPath}/home"><b>🏨 Hotel</b></a>
  <a href="${pageContext.request.contextPath}/rooms">Tìm phòng</a>
  <c:if test="${empty sessionScope.currentUser}">
    <a href="${pageContext.request.contextPath}/login">Đăng nhập</a>
    <a href="${pageContext.request.contextPath}/register">Đăng ký</a>
  </c:if>
  <c:if test="${not empty sessionScope.currentUser}">
    <c:if test="${sessionScope.currentUser.roleCode == 'CUSTOMER'}">
      <a href="${pageContext.request.contextPath}/my-reservations">Đơn của tôi</a>
      <a href="${pageContext.request.contextPath}/services">Dịch vụ</a>
    </c:if>
    <c:if test="${sessionScope.currentUser.roleCode == 'RECEPTIONIST' || sessionScope.currentUser.roleCode == 'ADMIN'}">
      <a href="${pageContext.request.contextPath}/reception/walkin">Walk-in</a>
      <a href="${pageContext.request.contextPath}/reception/customers">Khách hàng</a>
      <a href="${pageContext.request.contextPath}/reception/reservations">Đơn đặt phòng</a>
      <a href="${pageContext.request.contextPath}/reception/checkin">Check-in</a>
      <a href="${pageContext.request.contextPath}/reception/stays">Đang ở</a>
      <a href="${pageContext.request.contextPath}/reception/checkout">Check-out</a>
    </c:if>
    <c:if test="${sessionScope.currentUser.roleCode == 'SERVICE_STAFF' || sessionScope.currentUser.roleCode == 'RECEPTIONIST' || sessionScope.currentUser.roleCode == 'ADMIN'}">
      <a href="${pageContext.request.contextPath}/staff/service-requests">Yêu cầu DV</a>
    </c:if>
    <c:if test="${sessionScope.currentUser.roleCode == 'SERVICE_STAFF'}">
      <a href="${pageContext.request.contextPath}/staff/housekeeping">Housekeeping</a>
      <a href="${pageContext.request.contextPath}/staff/maintenance">Bảo trì</a>
    </c:if>
    <c:if test="${sessionScope.currentUser.roleCode == 'MANAGER'}">
      <a href="${pageContext.request.contextPath}/manager/dashboard">Dashboard</a>
      <a href="${pageContext.request.contextPath}/manager/rooms">Phòng</a>
      <a href="${pageContext.request.contextPath}/manager/room-types">Loại phòng</a>
      <a href="${pageContext.request.contextPath}/manager/pricing">Giá</a>
      <a href="${pageContext.request.contextPath}/manager/housekeeping">Housekeeping</a>
      <a href="${pageContext.request.contextPath}/manager/maintenance">Bảo trì</a>
      <a href="${pageContext.request.contextPath}/manager/reports">Báo cáo</a>
    </c:if>
    <a href="${pageContext.request.contextPath}/profile">👤 ${sessionScope.currentUser.fullName}</a>
    <a href="${pageContext.request.contextPath}/logout">Thoát</a>
  </c:if>
</nav>
<div class="container">
<c:if test="${not empty param.err}"><div class="err">${param.err}</div></c:if>
<c:if test="${not empty err}"><div class="err">${err}</div></c:if>
<c:if test="${not empty msg}"><div class="msg">${msg}</div></c:if>
